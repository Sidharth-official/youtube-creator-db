# ============================================================
# .gitignore — Digital Media & Creator Management System
# ============================================================

# ── MySQL Workbench ─────────────────────────────────────────
# Backup copies auto-generated by Workbench on every save.
# These are binary blobs that Git cannot diff or merge; always
# use the canonical *.mwb file instead.
*.mwb.bak

# Workbench autosave / crash-recovery scratch files
*.autosave

# ── Generic Temporary / Editor Files ────────────────────────
*.tmp
*.temp
*.swp
*.swo
*~
*.orig
*.rej

# ── macOS ────────────────────────────────────────────────────
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
Icon?

# ── Windows ─────────────────────────────────────────────────
Thumbs.db
ehthumbs.db
Desktop.ini
$RECYCLE.BIN/

# ── Linux ────────────────────────────────────────────────────
*~

# ── IDEs & Editors ───────────────────────────────────────────
.vscode/
.idea/
*.iml
*.sublime-workspace

# ── Python (if any helper scripts are added later) ───────────
__pycache__/
*.py[cod]
*.pyo

# ── Logs & dumps ─────────────────────────────────────────────
*.log
*.sql.bak
